# Socket server jis Next.js app se connections accept karega (CORS).
# Comma se multiple origins bhi de sakte hain (production + local dev):
# NEXT_BASE_URL=https://ishymartgrocery.vercel.app,http://localhost:3000
NEXT_BASE_URL=https://ishymartgrocery.vercel.app

PORT=5000

# ─── Naya: internal emit endpoint ke liye shared secret ───────────────────
# Next.js API routes yehi secret bhej kar is server ke POST /emit endpoint
# ko call karte hain taa k real-time updates (order status, location, naye
# broadcasts) connected clients ko turant push ho saken. Dono jagah (yahan
# aur snapcart ke .env mein) EXACTLY same value honi chahiye — koi bhi
# random lambi, unpredictable string bana lein aur kisi ko share na karein.
SOCKET_INTERNAL_SECRET=change-this-to-a-long-random-secret
